# FUUDELIVERY .ENV PRODUCTION TEMPLATE
# COPIE ESTE ARQUIVO PARA .env E PREENCHA COM DADOS REAIS
# NUNCA COMMITTE ESTE ARQUIVO NO GIT

# --- DATABASE (PostgreSQL 16) ---
DB_USER=fuud_admin_prod
DB_PASS=SuaSenhaForteAqui_!@#Min9876
DB_NAME=fuudelivery_prod
DB_HOST=db
DB_PORT=5432

# --- SECURITY & AUTH ---
# Gere com: openssl rand -base64 32
JWT_SECRET=SuaChaveSecretaJWT_Aqui_MuitoForte123!
ENCRYPTION_KEY=ChaveParaCriptografiaAES256_LGPD!

# --- PAYMENT GATEWAYS (PRODUCTION KEYS) ---
# MERCADO PAGO: Obter em https://www.mercadopago.com.br/developers
MP_ACCESS_TOKEN=APP_USR-XXXXXXXXXX-XXXXXXXXXX
MP_PUBLIC_KEY=XXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX
MP_WEBHOOK_SECRET=SeuSegredoDeValidacaoMP

# BITPAY: Obter em https://bitpay.com/dashboard/merchant/api-tokens
BITPAY_KEY=SuaChavePrivadaBitPay_Aqui
BITPAY_WEBHOOK_SECRET=SegredoWebhookBitPay

# --- CLOUDFLARE R2 (FOTOS/ARQUIVOS) ---
R2_ENDPOINT=https://account-id.r2.cloudflarestorage.com
R2_BUCKET=fuud-media-prod
R2_ACCESS_KEY=SuaAccessKeyR2
R2_SECRET_KEY=SuaSecretKeyR2

# --- APP SETTINGS ---
APP_ENV=production
APP_URL=https://seu-dominio.com
API_URL=https://api.seu-dominio.com

# --- EMAIL (SMTP) ---
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USER=apikey
MAIL_PASS=SuaSenhaSendGrid
MAIL_FROM=noreply@fuudelivery.com

# --- REDIS ---
REDIS_HOST=redis
REDIS_PORT=6379
